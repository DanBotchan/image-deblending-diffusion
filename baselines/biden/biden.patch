+"""
+Training script for BID with alpha-based blending.
+
+This script trains the BID model on alpha-blended images with random
+scalar or spatially-varying alpha values.
+"""
+
+import time
+import torch
+from options.train_options import TrainOptions
+from data import create_dataset
+from models import create_model
+from utils.visualizer import Visualizer
+from pathlib import Path
+import os
+
+
+class AlphaTrainOptions(TrainOptions):
+    """Extended training options with output_dir support."""
+
+    def initialize(self, parser):
+        parser = TrainOptions.initialize(self, parser)
+
+        # Override checkpoints_dir with output_dir structure
+        parser.add_argument('--output_dir', type=str, default='./outputs_alpha_bid',
+                            help='Root directory for all outputs (creates checkpoints/ subdirectory)')
+
+        return parser
+
+    def parse(self):
+        """Parse options and setup output directory structure."""
+        opt = self.gather_options()
+        opt.isTrain = self.isTrain
+
+        # Create output directory structure
+        if hasattr(opt, 'output_dir'):
+            output_path = Path(opt.output_dir)
+            opt.checkpoints_dir = str(output_path / 'checkpoints')
+            os.makedirs(opt.checkpoints_dir, exist_ok=True)
+
+        # Process opt.suffix
+        if opt.suffix:
+            suffix = ('_' + opt.suffix.format(**vars(opt))) if opt.suffix != '' else ''
+            opt.name = opt.name + suffix
+
+        self.print_options(opt)
+
+        # Set gpu ids
+        str_ids = opt.gpu_ids.split(',')
+        opt.gpu_ids = []
+        for str_id in str_ids:
+            id = int(str_id)
+            if id >= 0:
+                opt.gpu_ids.append(id)
+        if len(opt.gpu_ids) > 0:
+            torch.cuda.set_device(opt.gpu_ids[0])
+
+        self.opt = opt
+        return self.opt
+
+
+if __name__ == '__main__':
+    # Parse options
+    opt = AlphaTrainOptions().parse()
+
+    print("\n" + "="*60)
+    print("Alpha-Based Blending Training for BID")
+    print("="*60)
+    print(f"Dataset: {opt.dataroot}")
+    print(f"Dataset mode: {opt.dataset_mode}")
+    print(f"Alpha mode: {opt.alpha_mode}")
+    print(f"Alpha range: [{opt.alpha_min}, {opt.alpha_max}]")
+    print(f"Model: {opt.model}")
+    print(f"Output dir: {opt.output_dir if hasattr(opt, 'output_dir') else opt.checkpoints_dir}")
+    print(f"Experiment name: {opt.name}")
+    print("="*60 + "\n")
+
+    # Validation checks
+    if opt.dataset_mode != 'alpha_blend':
+        print("WARNING: dataset_mode should be 'alpha_blend' for alpha training!")
+        print(f"Current dataset_mode: {opt.dataset_mode}")
+        print("Continue anyway? (model may not work correctly)")
+
+    if opt.model not in ['alphabiden', 'biden2', 'biden']:
+        print(f"WARNING: Using model '{opt.model}' - recommended model is 'alphabiden'")
+        print("Continue anyway?")
+
+    # Create dataset and split into train/val
+    full_dataset = create_dataset(opt)
+    dataset_size = len(full_dataset)
+
+    # Split into train and validation (90/10 split)
+    from torch.utils.data import random_split, DataLoader
+    val_size = int(0.1 * dataset_size)
+    train_size = dataset_size - val_size
+
+    train_dataset, val_dataset = random_split(
+        full_dataset.dataset,  # Access underlying dataset from CustomDatasetDataLoader
+        [train_size, val_size],
+        generator=torch.Generator().manual_seed(42)  # Fixed seed for reproducibility
+    )
+
+    # Create dataloaders
+    dataloaders = {
+        'train': DataLoader(
+            train_dataset,
+            batch_size=opt.batch_size,
+            shuffle=True,
+            num_workers=int(opt.num_threads),
+            drop_last=True
+        ),
+        'val': DataLoader(
+            val_dataset,
+            batch_size=opt.batch_size,
+            shuffle=False,
+            num_workers=int(opt.num_threads),
+            drop_last=False
+        ),
+    }
+
+    print(f"Dataset split:")
+    print(f"  Total: {dataset_size} samples")
+    print(f"  Train: {train_size} samples ({100*train_size/dataset_size:.1f}%)")
+    print(f"  Val: {val_size} samples ({100*val_size/dataset_size:.1f}%)")
+    print()
+
+    # Create model
+    model = create_model(opt)
+    print(f'The number of training images = {train_size}')
+
+    # Create visualizer
+    visualizer = Visualizer(opt)
+    opt.visualizer = visualizer
+    total_iters = 0
+
+    optimize_time = 0.1
+    times = []
+
+    # Best checkpoint tracking
+    best_val_loss = float('inf')
+    best_epoch = 0
+
+    # Training loop
+    for epoch in range(opt.epoch_count, opt.n_epochs + opt.n_epochs_decay + 1):
+        epoch_start_time = time.time()
+        iter_data_time = time.time()
+        epoch_iter = 0
+        visualizer.reset()
+
+        # Set epoch for dataset if it has this method
+        if hasattr(dataloaders['train'].dataset, 'dataset'):
+            if hasattr(dataloaders['train'].dataset.dataset, 'set_epoch'):
+                dataloaders['train'].dataset.dataset.set_epoch(epoch)
+
+        for i, data in enumerate(dataloaders['train']):
+            iter_start_time = time.time()
+            if total_iters % opt.print_freq == 0:
+                t_data = iter_start_time - iter_data_time
+
+            batch_size = data["A"].size(0)
+            total_iters += batch_size
+            epoch_iter += batch_size
+
+            if len(opt.gpu_ids) > 0:
+                torch.cuda.synchronize()
+
+            optimize_start_time = time.time()
+
+            # Initialize model on first iteration
+            if epoch == opt.epoch_count and i == 0:
+                model.data_dependent_initialize(data)
+                model.setup(opt)
+                model.parallelize()
+
+            # Training step
+            model.set_input(data)
+            model.optimize_parameters()
+
+            if len(opt.gpu_ids) > 0:
+                torch.cuda.synchronize()
+
+            optimize_time = (time.time() - optimize_start_time) / batch_size * 0.005 + 0.995 * optimize_time
+
+            # Display images
+            if total_iters % opt.display_freq == 0:
+                save_result = total_iters % opt.update_html_freq == 0
+                model.compute_visuals()
+                visualizer.display_current_results(model.get_current_visuals(), epoch, save_result)
+
+            # Print losses
+            if total_iters % opt.print_freq == 0:
+                losses = model.get_current_losses()
+                visualizer.print_current_losses(epoch, epoch_iter, losses, optimize_time, t_data)
+                if opt.display_id is None or opt.display_id > 0:
+                    visualizer.plot_current_losses(epoch, float(epoch_iter) / train_size, losses)
+
+            # Save latest model
+            if total_iters % opt.save_latest_freq == 0:
+                print(f'Saving the latest model (epoch {epoch}, total_iters {total_iters})')
+                print(opt.name)
+                save_suffix = 'iter_%d' % total_iters if opt.save_by_iter else 'latest'
+                model.save_networks(save_suffix)
+
+            iter_data_time = time.time()
+
+        # Save model at epoch end
+        if epoch % opt.save_epoch_freq == 0:
+            print(f'Saving the model at the end of epoch {epoch}, iters {total_iters}')
+            model.save_networks('latest')
+            model.save_networks(epoch)
+
+        # Validation and best checkpoint saving
+        print('Running validation...')
+        model.eval()
+        val_losses = []
+
+        for val_i, val_data in enumerate(dataloaders['val']):
+            if val_i >= 100:  # Limit validation to 100 samples for speed
+                break
+
+            model.set_input(val_data)
+            with torch.no_grad():
+                model.forward()
+                # Compute reconstruction loss
+                val_loss = torch.nn.functional.l1_loss(model.fake_A, model.real_A) + \
+                          torch.nn.functional.l1_loss(model.fake_B, model.real_B)
+                val_losses.append(val_loss.item())
+
+        model.train()
+
+        avg_val_loss = sum(val_losses) / len(val_losses) if val_losses else float('inf')
+        print(f'Validation loss: {avg_val_loss:.6f}')
+
+        # Save best checkpoint if validation loss improved
+        if avg_val_loss < best_val_loss:
+            print(f'*** New best validation loss: {avg_val_loss:.6f} (previous: {best_val_loss:.6f}) ***')
+            best_val_loss = avg_val_loss
+            best_epoch = epoch
+            model.save_networks('best')
+            print(f'Best model saved at epoch {epoch}')
+
+        print(f'End of epoch {epoch} / {opt.n_epochs + opt.n_epochs_decay} \t '
+              f'Time Taken: {time.time() - epoch_start_time:.0f} sec')
+
+        # Update learning rates
+        model.update_learning_rate()
+
+    print("\n" + "="*60)
+    print("Training completed!")
+    print(f"Models saved to: {opt.checkpoints_dir}/{opt.name}/")
+    print(f"Best validation loss: {best_val_loss:.6f} at epoch {best_epoch}")
+    print(f"Best checkpoint: best_net_*.pth")
+    print("="*60)
