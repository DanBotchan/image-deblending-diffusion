@@ -0,0 +1,154 @@
+"""
+Alpha-based BID model that uses pre-computed alpha blending
+instead of random internal mixing.
+
+Based on biden2_model.py but modified to:
+1. Accept pre-blended inputs from dataset
+2. Use provided alpha maps instead of random mixing
+3. Train to decompose alpha-blended images
+"""
+
+import torch
+from .biden2_model import BIDEN2Model
+
+
+class AlphaBIDeNModel(BIDEN2Model):
+    """BID model adapted for alpha-based blending training."""
+
+    @staticmethod
+    def modify_commandline_options(parser, is_train=True):
+        """Add model-specific options"""
+        parser = BIDEN2Model.modify_commandline_options(parser, is_train)
+        # Alpha-specific options are in the dataset
+        return parser
+
+    def set_input(self, input):
+        """
+        Unpack input data from the dataloader.
+
+        For alpha training, we receive:
+        - 'A': Original image A
+        - 'B': Original image B
+        - 'input': Pre-blended image with our alpha
+        - 'alpha_map': The alpha map used for blending
+        """
+        self.real_A = input['A'].to(self.device)
+        self.real_B = input['B'].to(self.device)
+        # alpha_test.py provides 'alpha'; the alpha_blend training dataset 'alpha_map'.
+        alpha = input['alpha'] if 'alpha' in input else input['alpha_map']
+        self.alpha_map = alpha.to(self.device) if torch.is_tensor(alpha) else alpha
+        self.real_input  =  (self.real_A * self.alpha_map  + (1 - self.alpha_map) * self.real_B)
+
+    def forward(self):
+        """
+        Run forward pass with pre-computed blending.
+
+        Unlike original BID which creates random mix internally,
+        we use the pre-blended input from the dataset.
+        """
+        # If we have pre-blended input, use it directly
+        if self.real_input is not None:
+            # Set labels to indicate both components are present
+            # (equivalent to alpha and 1-alpha weighting)
+            self.label[0] = 1.0
+            self.label[1] = 1.0
+            self.loss_sum = torch.tensor(2.0).to(self.device)  # Sum of weights
+
+        else:
+            # Fallback to original BID random mixing
+            label_sum = 0
+            while label_sum < 1:
+                p = torch.rand(self.opt.max_domain)
+                for i in range(self.opt.max_domain):
+                    if p[i] < self.opt.prob:
+                        self.label[i] = 1
+                    else:
+                        self.label[i] = 0
+                label_sum = torch.sum(self.label, 0)
+
+            self.real_input = (self.real_A * self.label[0] + self.real_B * self.label[1]) / label_sum
+            self.loss_sum = label_sum
+
+        # Forward through networks (same as original)
+        self.fake_all = self.netE(self.real_input)
+        self.fake_A = self.netH1(self.fake_all)
+        self.fake_B = self.netH2(self.fake_all)
+
+    def compute_D_loss(self):
+        """Calculate GAN loss and BCE loss for the discriminator (batch-aware)"""
+        fake1 = self.fake_A.detach()
+        fake2 = self.fake_B.detach()
+        pred_fake1 = self.netD(0, fake1)
+        pred_fake2 = self.netD(0, fake2)
+        self.loss_D_fake = self.criterionGAN(pred_fake1, False) * self.label[0] \
+                           + self.criterionGAN(pred_fake2, False) * self.label[1]
+
+        # Real
+        self.pred_real1 = self.netD(0, self.real_A)
+        self.pred_real2 = self.netD(0, self.real_B)
+
+        self.loss_D_real = self.criterionGAN(self.pred_real1, True) * self.label[0] \
+                           + self.criterionGAN(self.pred_real2, True) * self.label[1]
+
+        # BCE loss, netD(1) for the source prediction branch.
+        # Fix: use view(-1, max_domain) to handle batch size correctly
+        batch_size = self.real_input.size(0)
+        self.predict_label = self.netD(1, self.real_input).view(batch_size, self.opt.max_domain)
+
+        # Expand label to match batch size
+        label_expanded = self.label.unsqueeze(0).expand(batch_size, -1)
+        self.loss_BCE = self.criterionBCE(self.predict_label, label_expanded)
+
+        # combine loss and calculate gradients
+        self.loss_D = (self.loss_D_fake + self.loss_D_real) * 0.5 * self.opt.lambda_GAN + self.loss_BCE * self.opt.lambda_BCE
+        return self.loss_D
+
+    def compute_G_loss(self):
+        """
+        Calculate loss for generator (batch-aware).
+        Modified to handle alpha-based training and batch processing.
+        """
+        # GAN loss (combined for both outputs)
+        pred_fake1 = self.netD(0, self.fake_A)
+        pred_fake2 = self.netD(0, self.fake_B)
+        self.loss_G_GAN = self.criterionGAN(pred_fake1, True) * self.label[0] + \
+                          self.criterionGAN(pred_fake2, True) * self.label[1]
+
+        # Reconstruction loss (L1)
+        self.loss_Ln = self.criterionL1(self.fake_A, self.real_A) * self.label[0] + \
+                       self.criterionL1(self.fake_B, self.real_B) * self.label[1]
+
+        # VGG perceptual loss
+        self.loss_VGG = self.criterionVGG(self.fake_A, self.real_A) * self.label[0] + \
+                        self.criterionVGG(self.fake_B, self.real_B) * self.label[1]
+
+        # BCE loss for source prediction
+        # Fix: use view(-1, max_domain) to handle batch size correctly
+        batch_size = self.real_input.size(0)
+        self.predict_label = self.netD(1, self.real_input).view(batch_size, self.opt.max_domain)
+
+        # Expand label to match batch size
+        label_expanded = self.label.unsqueeze(0).expand(batch_size, -1)
+        self.loss_BCE = self.criterionBCE(self.predict_label, label_expanded)
+
+        # Total loss
+        self.loss_G = self.loss_G_GAN * self.opt.lambda_GAN + \
+                     self.loss_Ln * self.opt.lambda_Ln + \
+                     self.loss_VGG * self.opt.lambda_VGG + \
+                     self.loss_BCE * self.opt.lambda_BCE
+
+        return self.loss_G
+
+    def forward_test(self):
+        gt_label = [0] * self.opt.max_domain
+        self.real_input = (self.real_A * self.alpha_map  + (1 - self.alpha_map) * self.real_B)
+        self.fake_all = self.netE(self.real_input)
+        self.predict_label = self.netD(1, self.real_input).view(self.opt.max_domain)
+        predict_label = torch.where(self.predict_label > 0.0, 1, 0)
+        self.fake_A = self.netH1(self.fake_all)
+        self.fake_B = self.netH2(self.fake_all)
+        if predict_label.tolist() == gt_label:
+            self.correct = self.correct + 1
+        self.all_count = self.all_count + 1
+        if self.all_count == 300:
+            print(self.correct / self.all_count)
