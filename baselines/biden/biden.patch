@@ -0,0 +1,324 @@
+"""
+Evaluation script for alpha-trained BID model.
+
+This script evaluates the BID model trained with alpha-based blending
+using the same dataset and output structure as my_test.py.
+"""
+
+import argparse
+import ast
+import json
+import os
+import sys
+from pathlib import Path
+from typing import Union, Dict, Any
+
+import matplotlib.pyplot as plt
+import pandas as pd
+import torch
+from PIL import Image
+from torch.utils.data import DataLoader
+
+
+from alphas.alpha_maps import get_alpha_map
+
+from data.base_dataset import BaseDataset, get_transform
+from models import create_model
+from options.test_options import TestOptions
+from utils.util import tensor2im, save_image
+
+
+def plot_map(map_tensor):
+    """Plot alpha map as grayscale image."""
+    fig, ax = plt.subplots(1)
+    img = map_tensor.detach().cpu().numpy()
+    img_plot = ax.imshow(img, vmin=0, vmax=1)
+    ax.set_title(f'Min: {img.min():.3f}, Max: {img.max():.3f}')
+    img_plot.set_cmap('gray')
+    return fig
+
+
+def save_json(file_path: Union[str, Path], data: Dict[str, Any]):
+    """Save dictionary as JSON file."""
+    with open(file_path, 'w') as fp:
+        json.dump(data, fp, indent=4, default=str)
+
+
+class AlphaEvalDataset(BaseDataset):
+    """Dataset for evaluating alpha-trained BID model.
+
+    Loads from CSV with columns:
+    - img1_path, img2_path: paths to images
+    - a, b, c, d, e, f: polynomial alpha coefficients
+    - img1_class, img2_class: class labels
+    - img1_prompt, img2_prompt: prompts (optional)
+    - z_seeds: random seeds used (optional)
+    """
+
+    def __init__(self, opt):
+        """Initialize dataset."""
+        BaseDataset.__init__(self, opt)
+        self.opt = opt
+        self.csv_root = Path(opt.dataroot)
+        self.root = self.csv_root.parent
+        self.data = pd.read_csv(self.csv_root)
+        self.switch_order = opt.switch_order
+        self.transform = get_transform(self.opt)
+
+        print(f"AlphaEvalDataset initialized:")
+        print(f"  CSV: {self.csv_root}")
+        print(f"  Root: {self.root}")
+        print(f"  Samples: {len(self.data)}")
+
+    def __getitem__(self, index: int) -> Dict[str, Union[torch.Tensor, str]]:
+        """Get a sample from the dataset."""
+        pair = self.data.iloc[index]
+        image1_path = self.root / pair['img1_path']
+        image2_path = self.root / pair['img2_path']
+
+        image1 = self.transform(Image.open(image1_path).convert('RGB'))
+        image2 = self.transform(Image.open(image2_path).convert('RGB'))
+        try:
+            alpha_gt = pair[['a', 'b', 'c', 'd', 'e', 'f']].values.tolist()
+        except:
+            alpha_gt = [0.5, 0, 0, 0, 0, 0]
+
+        return {
+            # Model expects 'A' and 'B'
+            'A': image1,
+            'B': image2,
+            # Keep original keys for metadata
+            'image1': image1,
+            'image1_path': str(image1_path),
+            'image1_class': pair['img1_class'],
+            'image1_prompt': pair.get('img1_prompt', ''),
+            'image2': image2,
+            'image2_path': str(image2_path),
+            'image2_class': pair['img2_class'],
+            'image2_prompt': pair.get('img2_prompt', ''),
+            'A_paths': str(image1_path),
+            'B_paths': str(image2_path),
+            'index': index,
+            'alpha_gt': alpha_gt,
+            'pair_seeds': ast.literal_eval(pair['z_seeds']) if 'z_seeds' in pair else [],
+            'pair_idx': index,
+        }
+
+    def __len__(self):
+        """Return dataset size."""
+        return len(self.data)
+
+
+class AlphaTestOptions(TestOptions):
+    """Extended test options for alpha evaluation."""
+
+    def initialize(self, parser):
+        parser = TestOptions.initialize(self, parser)
+
+        # Alpha-specific options
+        parser.add_argument('--alpha_mode', type=str, default='spatial',
+                            choices=['scalar', 'spatial'],
+                            help='Alpha mode used during training')
+        parser.add_argument('--alpha_min', type=float, default=0.2,
+                            help='Minimum alpha value')
+        parser.add_argument('--alpha_max', type=float, default=0.8,
+                            help='Maximum alpha value')
+
+        # Save arguments
+        parser.add_argument('--save_args', action='store_true', default=True,
+                            help='Save arguments to JSON file')
+
+        return parser
+
+    def gather_options(self):
+        """Override to skip dataset-specific options since we define dataset in script."""
+        if not self.initialized:
+            parser = argparse.ArgumentParser(formatter_class=argparse.ArgumentDefaultsHelpFormatter)
+            parser = self.initialize(parser)
+
+        # Get basic options
+        if self.cmd_line is None:
+            opt, _ = parser.parse_known_args()
+        else:
+            opt, _ = parser.parse_known_args(self.cmd_line)
+
+        # Modify model-related parser options
+        from models import get_option_setter as get_model_option_setter
+        model_name = opt.model
+        model_option_setter = get_model_option_setter(model_name)
+        parser = model_option_setter(parser, self.isTrain)
+
+        if self.cmd_line is None:
+            opt, _ = parser.parse_known_args()
+        else:
+            opt, _ = parser.parse_known_args(self.cmd_line)
+
+        # Skip dataset-specific options - we define dataset in the script
+        self.parser = parser
+
+        if self.cmd_line is None:
+            return parser.parse_args()
+        else:
+            return parser.parse_args(self.cmd_line)
+
+
+def save_arguments(opt, save_dir):
+    """Save all arguments to JSON file."""
+    args_dict = vars(opt).copy()
+
+    # Convert non-serializable types
+    for key, value in args_dict.items():
+        if not isinstance(value, (str, int, float, bool, list, dict, type(None))):
+            args_dict[key] = str(value)
+
+    save_path = save_dir / 'arguments.json'
+    save_json(save_path, args_dict)
+    print(f"Arguments saved to: {save_path}")
+
+
+if __name__ == '__main__':
+    # Parse options
+    opt = AlphaTestOptions().parse()
+
+    opt.num_threads = 0
+    opt.serial_batches = True
+    opt.no_flip = True
+    opt.display_id = -1
+
+    print("\n" + "="*60)
+    print("Alpha-Based BID Model Evaluation")
+    print("="*60)
+    print(f"Dataset: {opt.dataroot}")
+    print(f"Model: {opt.model}")
+    print(f"Checkpoint: {opt.epoch}")
+    print(f"Results dir: {opt.results_dir}")
+    print(f"Alpha mode: {opt.alpha_mode}")
+    print(f"Alpha range: [{opt.alpha_min}, {opt.alpha_max}]")
+    print(f"Num test: {opt.num_test}")
+    print("="*60 + "\n")
+
+    # Create dataset and dataloader
+    dataset = AlphaEvalDataset(opt)
+    dataloader = DataLoader(
+        dataset=dataset,
+        batch_size=1,
+        shuffle=False,
+        num_workers=0,
+        pin_memory=True,
+        drop_last=False,
+    )
+
+    # Create model
+    model = create_model(opt)
+    save_dir = Path(opt.results_dir)
+    save_dir.mkdir(parents=True, exist_ok=True)
+
+    # Save arguments if requested
+    if opt.save_args:
+        save_arguments(opt, save_dir)
+
+    # Evaluation loop
+    for i, data in enumerate(dataloader):
+        pair_name = f"pair_{data['pair_idx'].item():03d}/smp_0000"
+        save_path = save_dir / pair_name
+        save_path.mkdir(parents=True, exist_ok=True)
+
+        # Create alpha map from ground truth coefficients
+        alpha = get_alpha_map(
+            name='param_2d_order',
+            init_alpha=data['alpha_gt'],
+            device='cuda' if torch.cuda.is_available() else 'cpu',
+            alpha_min=opt.alpha_min,
+            alpha_max=opt.alpha_max,
+            size=opt.crop_size,
+        )
+        data['alpha'] = alpha
+
+        # Initialize model on first iteration
+        if i == 0:
+            model.data_dependent_initialize(data)
+            model.setup(opt)
+            model.parallelize()
+            if opt.eval:
+                model.eval()
+
+        if i >= opt.num_test:
+            break
+
+        # Run inference
+        model.set_input(data)
+        model.test()
+        visuals = model.get_current_visuals()
+        img_path = model.get_image_paths()
+
+        if i % 50 == 0:
+            print(f'Processing ({i:04d})-th image... {img_path}')
+
+        # Map BID visual names to expected output names
+        # BID model returns: fake_A, fake_B, real_A, real_B, real_input
+        # We need: sample1, sample2, blended_gt, blended_sample
+
+        # Save images with correct naming
+        save_image(tensor2im(visuals['fake_A']), save_path / 'sample1.png', aspect_ratio=1.0)
+        save_image(tensor2im(visuals['fake_B']), save_path / 'sample2.png', aspect_ratio=1.0)
+        save_image(tensor2im(visuals['real_input']), save_path / 'blended_gt.png', aspect_ratio=1.0)
+
+        # Reconstruct blended image from predictions
+        # Get alpha map and reconstruct: blended = alpha * fake_A + (1-alpha) * fake_B
+        alpha_2d = alpha.forward()  # [H, W]
+        alpha_3ch = alpha_2d.unsqueeze(0).unsqueeze(0).expand(1, 3, -1, -1)  # [1, 3, H, W]
+        alpha_3ch = alpha_3ch.to(visuals['fake_A'].device)
+
+        # Convert from [-1, 1] to [0, 1] for blending, then back
+        fake_A_01 = (visuals['fake_A'] + 1) / 2.0
+        fake_B_01 = (visuals['fake_B'] + 1) / 2.0
+        blended_sample_01 = alpha_3ch * fake_A_01 + (1 - alpha_3ch) * fake_B_01
+        blended_sample = blended_sample_01 * 2.0 - 1.0
+
+        save_image(tensor2im(blended_sample), save_path / 'blended_sample.png', aspect_ratio=1.0)
+
+        # Save details JSON
+        save_json(
+            save_path / 'details.json',
+            {
+                "image1_path": data['image1_path'][0] if isinstance(data['image1_path'], list) else data['image1_path'],
+                "image1_class": data['image1_class'][0] if isinstance(data['image1_class'], list) else data['image1_class'],
+                "image1_prompt": data['image1_prompt'][0] if isinstance(data['image1_prompt'], list) else data['image1_prompt'],
+                "image2_path": data['image2_path'][0] if isinstance(data['image2_path'], list) else data['image2_path'],
+                "image2_class": data['image2_class'][0] if isinstance(data['image2_class'], list) else data['image2_class'],
+                "image2_prompt": data['image2_prompt'][0] if isinstance(data['image2_prompt'], list) else data['image2_prompt'],
+                "sample1_path": str(save_path / 'sample1.png'),
+                "sample2_path": str(save_path / 'sample2.png'),
+                "sample_time": 0.0,
+                "smp_seed": None,
+                "pair_idx": data['pair_idx'].item(),
+            }
+        )
+
+        # Save alpha information
+        alpha_temp = {
+            "type": "param_2d_order",
+            "parameters": [t.item() for t in alpha.get_scaled_parameters()],
+            "raw_parameters": [t.item() for t in alpha.get_parameters()],
+            "init_parameters": [t.item() for t in alpha.init_alpha],
+        }
+
+        save_json(
+            save_path / 'alphas.json',
+            {
+                "pred": alpha_temp,
+                "gt": alpha_temp,
+                "init_pred_map": alpha_temp
+            }
+        )
+
+        # Save alpha map visualization
+        alpha_fig = plot_map(alpha.forward())
+        alpha_fig.savefig(save_path / 'pred_map.png')
+        alpha_fig.savefig(save_path / 'gt_map.png')
+        plt.close(alpha_fig)
+
+    print("\n" + "="*60)
+    print("Evaluation completed!")
+    print(f"Results saved to: {save_dir}")
+    print("="*60)
