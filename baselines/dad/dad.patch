+def save_sample_images(batch, G_pred1, G_pred2, save_dir, step, device):
+    """
+    Save samples in the GIP_v2 format:
+    - {step}_alpha_map.png
+    - {step}_gt_X1.png
+    - {step}_gt_X2.png
+    - {step}_input_Y.png
+    - {step}_predicted_X2.png
+    - {step}_recovered_X1.png
+    """
+    os.makedirs(save_dir, exist_ok=True)
+
+    # Take the first sample from the batch
+    input_Y = batch['input'][0].cpu().detach().numpy().transpose(1, 2, 0)  # [H, W, 3]
+    gt_X1 = batch['gt1'][0].cpu().detach().numpy().transpose(1, 2, 0)
+    gt_X2 = batch['gt2'][0].cpu().detach().numpy().transpose(1, 2, 0)
+    alpha_map = batch['alpha_map'][0].cpu().detach().numpy()  # [H, W]
+
+    predicted_X2 = G_pred2[0].cpu().detach().numpy().transpose(1, 2, 0)
+    predicted_X1 = G_pred1[0].cpu().detach().numpy().transpose(1, 2, 0)
+
+    # Clip predictions to [0, 1] range (model output can exceed this range during training)
+    # Ground truth and input are already in [0, 1] range from the dataset
+    predicted_X1 = np.clip(predicted_X1, 0, 1)
+    predicted_X2 = np.clip(predicted_X2, 0, 1)
+
+    # Save images
+    plt.imsave(os.path.join(save_dir, f'{step:06d}_input_Y.png'), input_Y)
+    plt.imsave(os.path.join(save_dir, f'{step:06d}_gt_X1.png'), gt_X1)
+    plt.imsave(os.path.join(save_dir, f'{step:06d}_gt_X2.png'), gt_X2)
+    plt.imsave(os.path.join(save_dir, f'{step:06d}_predicted_X2.png'), predicted_X2)
+    plt.imsave(os.path.join(save_dir, f'{step:06d}_recovered_X1.png'), predicted_X1)
+
+    # Save alpha map as grayscale heatmap
+    plt.imsave(os.path.join(save_dir, f'{step:06d}_alpha_map.png'),
+               alpha_map, cmap='gray', vmin=0, vmax=1)
+
+
+class UnmixGANWithSampling(um.UnmixGAN):
+    """Extended UnmixGAN class that saves samples during training"""
+
+    def __init__(self, args, dataloaders, samples_dir, save_samples_every):
+        super().__init__(args, dataloaders)
+        self.samples_dir = samples_dir
+        self.save_samples_every = save_samples_every
+        self.global_step = 0
+
+        # Create samples directory
+        os.makedirs(self.samples_dir, exist_ok=True)
+
+    def _compute_acc(self):
+        """Override to add MSE metric support"""
+        device = torch.device("cuda:0" if torch.cuda.is_available() else "cpu")
+
+        target1 = self.batch['gt1'].to(device).detach()
+        target2 = self.batch['gt2'].to(device).detach()
+        img1 = self.G_pred1.detach()
+        img2 = self.G_pred2.detach()
+
+        if self.metric == 'mse':
+            # MSE for both predictions (lower is better)
+            mse1 = torch.mean((img1 - target1) ** 2) + torch.mean((img2 - target2) ** 2)
+            mse2 = torch.mean((img1 - target2) ** 2) + torch.mean((img2 - target1) ** 2)
+            return torch.min(mse1, mse2)  # Return minimum MSE (best assignment)
+        else:
+            # Use parent class implementation for other metrics
+            return super()._compute_acc()
+
+    def _update_checkpoints(self):
+        """Override to handle MSE metric (lower is better)"""
+        # save current model
+        self._save_checkpoint(ckpt_name='last_ckpt.pt')
+        print('Latest model updated. Epoch_acc=%.4f, Historical_best_acc=%.4f (at epoch %d)'
+              % (self.epoch_acc, self.best_val_acc, self.best_epoch_id))
+        print()
+
+        # update the best model (based on eval acc)
+        if self.metric in ['mse', 'labrmse_gt1']:
+            # Lower score is better
+            if self.epoch_acc < self.best_val_acc:
+                self.best_val_acc = self.epoch_acc
+                self.best_epoch_id = self.epoch_id
+                self._save_checkpoint(ckpt_name='best_ckpt.pt')
+                print('*' * 10 + 'Best model updated!')
+                print()
+        else:
+            # Higher score is better (PSNR, SSIM)
+            if self.epoch_acc > self.best_val_acc:
+                self.best_val_acc = self.epoch_acc
+                self.best_epoch_id = self.epoch_id
+                self._save_checkpoint(ckpt_name='best_ckpt.pt')
+                print('*' * 10 + 'Best model updated!')
+                print()
+
+    def _collect_running_batch_states(self):
+        """Override to add sample saving"""
+        self.running_acc.append(self._compute_acc().item())
+
+        m = len(self.dataloaders['train'])
+        if self.is_training is False:
+            m = len(self.dataloaders['val'])
+
+        if np.mod(self.batch_id, 100) == 1 or self.batch_id == m-1:
+            print('Is_training: %s. [%d,%d][%d,%d], G_loss: %.8f, D_loss: %.8f, running_acc: %.8f (%s),'
+                  % (self.is_training, self.epoch_id, self.max_num_epochs-1, self.batch_id, m,
+                     self.G_loss.item(), self.D_loss.item(),
+                     np.mean(self.running_acc), self.metric))
+
+        # Save samples during validation
+        if not self.is_training and (np.mod(self.batch_id, 10) == 0 or self.batch_id == m-1):
+            step = self.epoch_id * 1000 + self.batch_id  # Unique step identifier
+            save_sample_images(
+                self.batch, self.G_pred1, self.G_pred2,
+                self.samples_dir, step, torch.device("cuda:0" if torch.cuda.is_available() else "cpu")
+            )
+
+        # Original visualization
+        if np.mod(self.batch_id, 1000) == 1 or self.batch_id == m-1:
+            vis_input = um.utils.make_numpy_grid(self.batch['input'])
+            vis_pred1 = um.utils.make_numpy_grid(self.G_pred1)
+            vis_pred2 = um.utils.make_numpy_grid(self.G_pred2)
+
+            # Images are already in [0, 1] range (unlike original DAD which uses [0, 0.5])
+            if self.output_auto_enhance:
+                vis_pred1 = vis_pred1 * 1.5
+                vis_pred2 = vis_pred2 * 1.5
+
+            vis = np.concatenate([vis_input, vis_pred1, vis_pred2], axis=0)
+            vis = np.clip(vis, a_min=0.0, a_max=1.0)
+            file_name = os.path.join(
+                self.vis_dir, 'istrain_'+str(self.is_training)+'_'+
+                              str(self.epoch_id)+'_'+str(self.batch_id)+'.jpg')
+            plt.imsave(file_name, vis)
+
+
+if __name__ == '__main__':
