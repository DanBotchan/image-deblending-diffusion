+from pathlib import Path
+import argparse
+import os
+import numpy as np
+import matplotlib.pyplot as plt
+
+from torch.utils.data import DataLoader
+
+from alpha_dataset import AlphaBlendingDataset
+import unmix_gan as um
+import torch
+
+# settings
+def get_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description='DAD Training with Alpha-based Blending')
+
+    # Dataset args
+    parser.add_argument('--data_path', type=str, required=True,
+                        help="Path to the dataset root folder with trainA and trainB")
+    parser.add_argument('--img_size', type=int, default=256,
+                        help='Image size for training (default: 256)')
+
+    # Alpha blending args
+    parser.add_argument('--alpha_mode', type=str, default='scalar',
+                        choices=['scalar', 'spatial'],
+                        help='Alpha mode: scalar for constant alpha, spatial for polynomial map (default: scalar)')
+    parser.add_argument('--alpha_min', type=float, default=0.4,
+                        help='Minimum alpha value (default: 0.4)')
+    parser.add_argument('--alpha_max', type=float, default=0.6,
+                        help='Maximum alpha value (default: 0.6)')
+
+    # Model args
+    parser.add_argument('--net_G', type=str, default='unet_128', metavar='str',
+                        help='net_G: unet_512, unet_256 or unet_128 or unet_64 (default: unet_128)')
+    parser.add_argument('--ngf', type=int, default=64, metavar='N',
+                        help='number of base filters in G')
+    parser.add_argument('--batch_size', type=int, default=4, metavar='N',
+                        help='input batch size for training (default: 4)')
+
+    # Loss args
+    parser.add_argument('--pixel_loss', type=str, default='minimum_pixel_loss', metavar='str',
+                        help='type of pixel loss from [minimum_pixel_loss, pixel_loss] (default: minimum_pixel_loss)')
+    parser.add_argument('--enable_d1d2', action='store_true', default=False,
+                        help='improve the G by adversarial training with D1/D2')
+    parser.add_argument('--enable_d3', action='store_true', default=False,
+                        help='improve the G by adversarial training with D3')
+    parser.add_argument('--enable_synfake', action='store_true', default=False,
+                        help='to use synfake sample for training D')
+    parser.add_argument('--enable_exclusion_loss', action='store_true', default=False,
+                        help='improve the G by using exclusion loss')
+    parser.add_argument('--enable_kurtosis_loss', action='store_true', default=False,
+                        help='improve the G by using kurtosis loss')
+
+    # Training args
+    parser.add_argument('--lr', type=float, default=1e-4,
